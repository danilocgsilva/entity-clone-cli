#!/usr/bin/env php
<?php

require dirname(__DIR__).'/vendor/autoload.php';

use Symfony\Component\Console\Application;
use Danilocgsilva\EntityCloneCli\Command\CloneRecordCommand;
use Danilocgsilva\EntityCloneCli\Command\CompareTablesCommand;
use Danilocgsilva\EntityCloneCli\Command\DeleteConnectionCommand;
use Danilocgsilva\EntityCloneCli\Command\ListFieldsCommand;
use Danilocgsilva\EntityCloneCli\Command\ListConnectionsCommand;
use Danilocgsilva\EntityCloneCli\Command\ListTablesCommand;
use Danilocgsilva\EntityCloneCli\Command\ListDatabasesCommand;
use Danilocgsilva\EntityCloneCli\Command\RegisterConnectionCommand;
use Danilocgsilva\EntityCloneCli\Command\TestConnectionCommand;
use Danilocgsilva\EntityCloneCli\Command\UpdateConnectionCommand;
use Danilocgsilva\EntityCloneCli\Command\ShowForeignKeysCommand;
use Danilocgsilva\EntityCloneCli\Command\CompareDatabasesCommand;
use Danilocgsilva\EntityCloneCli\Command\CreateTableFromSourceCommand;
use Danilocgsilva\EntityCloneCli\Command\GetCreateTableStatementCommand;
use Danilocgsilva\EntityCloneCli\Command\CreateMissingDatabaseCommand;
use Danilocgsilva\EntityCloneCli\Command\SyncDatabasesCommand;

$application = new Application('My CLI App', '1.0.0');

$application->addCommands([
    new CloneRecordCommand(),
    new CompareTablesCommand(),
    new DeleteConnectionCommand(),
    new ListConnectionsCommand(),
    new ListFieldsCommand(),
    new ListTablesCommand(),
    new ListDatabasesCommand(),
    new RegisterConnectionCommand(),
    new TestConnectionCommand(),
    new UpdateConnectionCommand(),
    new ShowForeignKeysCommand(),
    new CompareDatabasesCommand(),
    new CreateTableFromSourceCommand(),
    new GetCreateTableStatementCommand(),
    new CreateMissingDatabaseCommand(),
    new SyncDatabasesCommand(),
]);

$application->run();