#!/usr/bin/env php
<?php

require dirname(__DIR__).'/vendor/autoload.php';

use Symfony\Component\Console\Application;
use Danilocgsilva\EntityCloneCli\CloneRecordCommand;
use Danilocgsilva\EntityCloneCli\CompareTablesCommand;
use Danilocgsilva\EntityCloneCli\DeleteConnectionCommand;
use Danilocgsilva\EntityCloneCli\ListFieldsCommand;
use Danilocgsilva\EntityCloneCli\ListConnectionsCommand;
use Danilocgsilva\EntityCloneCli\ListTablesCommand;
use Danilocgsilva\EntityCloneCli\ListDatabasesCommand;
use Danilocgsilva\EntityCloneCli\RegisterConnectionCommand;
use Danilocgsilva\EntityCloneCli\TestConnectionCommand;
use Danilocgsilva\EntityCloneCli\UpdateConnectionCommand;
use Danilocgsilva\EntityCloneCli\ShowForeignKeysCommand;
use Danilocgsilva\EntityCloneCli\CreateTableFromSourceCommand;
use Danilocgsilva\EntityCloneCli\GetCreateTableStatementCommand;

$application = new Application('My CLI App', '1.0.0');

$application->addCommands([
    new CloneRecordCommand(),
    new CompareTablesCommand(),
    new DeleteConnectionCommand(),
    new ListConnectionsCommand(),
    new ListFieldsCommand(),
    new ListTablesCommand(),
    new ListDatabasesCommand(),
    new RegisterConnectionCommand(),
    new TestConnectionCommand(),
    new UpdateConnectionCommand(),
    new ShowForeignKeysCommand(),
    new CreateTableFromSourceCommand(),
    new GetCreateTableStatementCommand(),
]);

$application->run();