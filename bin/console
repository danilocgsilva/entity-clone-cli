#!/usr/bin/env php
<?php

require dirname(__DIR__).'/vendor/autoload.php';

use Symfony\Component\Console\Application;
use Danilocgsilva\EntityCloneCli\{DatabaseConnectionLister, Helpers};
use Danilocgsilva\EntityCloneCli\Command\{
    CloneRecordCommand,
    CompareTablesCommand,
    DeleteConnectionCommand,
    ListFieldsCommand,
    ListConnectionsCommand,
    ListTablesCommand,
    ListDatabasesCommand,
    RegisterConnectionCommand,
    TestConnectionCommand,
    UpdateConnectionCommand,
    ShowForeignKeysCommand,
    CompareDatabasesCommand,
    CreateTableFromSourceCommand,
    GetCreateTableStatementCommand,
    CreateMissingDatabaseCommand,
    SyncDatabasesCommand,
    TestAllConnectionsCommand,
    CreateDatabaseCommand,
    ListDatabaseSizesCommand
};

$application = new Application('My CLI App', '1.0.0');

$databaseConnectionLister = new DatabaseConnectionLister(Helpers::createEntityManager());

$application->addCommands([
    new CloneRecordCommand(),
    new CompareTablesCommand(),
    new DeleteConnectionCommand($databaseConnectionLister),
    new ListConnectionsCommand($databaseConnectionLister),
    new ListFieldsCommand(),
    new ListTablesCommand(),
    new ListDatabasesCommand($databaseConnectionLister),
    new RegisterConnectionCommand(),
    new TestConnectionCommand($databaseConnectionLister),
    new UpdateConnectionCommand(),
    new ShowForeignKeysCommand(),
    new CompareDatabasesCommand(),
    new CreateTableFromSourceCommand(),
    new GetCreateTableStatementCommand(),
    new CreateMissingDatabaseCommand(),
    new SyncDatabasesCommand($databaseConnectionLister),
    new TestAllConnectionsCommand($databaseConnectionLister),
    new CreateDatabaseCommand(),
    new ListDatabaseSizesCommand($databaseConnectionLister)
]);

$application->run();